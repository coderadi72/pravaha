APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_ATTACHMENT_MAX_BYTES=5242880
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_SCHEMA=public
SQL_ECHO=false
# Production defaults to Secure cookies and disabled docs. Override deliberately:
# SESSION_COOKIE_SECURE=true
# ENABLE_API_DOCS=false
SESSION_COOKIE_SAMESITE=lax
JWT_SECRET=
SESSION_SECRET=
TEST_DATABASE_URL=

# Required for an explicit fresh demo seed. Blank passwords fail before writing.
SEED_ADMIN_EMAIL=admin@pravaha.local
SEED_ADMIN_PASSWORD=
SEED_PM_EMAIL=pm001@pravaha.local
SEED_PM_PASSWORD=
SEED_TL_EMAIL=tl001@pravaha.local
SEED_TL_PASSWORD=

# Phase 8 deterministic execution warning thresholds (calendar days)
INTELLIGENCE_STALE_DAYS=7
INTELLIGENCE_FINISH_WINDOW_DAYS=3
INTELLIGENCE_MIN_PROGRESS=80
INTELLIGENCE_HIGH_DELAY_DAYS=7
INTELLIGENCE_INCOMPLETE_THRESHOLD=3

# Phase 9 production controls. Production requires PostgreSQL throttling, SSL and exact HTTPS origins.
DB_POOL_MODE=queue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
RATE_LIMIT_BACKEND=memory
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_BUCKETS=10000
# Signup is approval-only. Blank review organization resolves only when one exists.
REGISTRATION_REVIEW_ORGANIZATION_ID=
SIGNUP_MAX_ATTEMPTS=5
SIGNUP_WINDOW_SECONDS=900
SIGNUP_MAX_BUCKETS=10000
SESSION_TTL_SECONDS=28800
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_UPLOAD_BODY_LIMIT_BYTES=8388608
ATTACHMENT_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=20000000
XLSX_MAX_ENTRIES=1000
XLSX_MAX_UNCOMPRESSED_BYTES=41943040
XLSX_MAX_COMPRESSION_RATIO=300
SCHEDULE_MAX_ROWS=2000
SCHEDULE_MAX_COLUMNS=60
SCHEDULE_MAX_RELATIONSHIPS=10000
DEPENDENCY_CELL_MAX_COUNT=50
DEPENDENCY_MAX_LAG_DAYS=3650
INTELLIGENCE_MAX_INPUT_ROWS=10000
TRUSTED_PROXY_IPS=127.0.0.1
OCR_PROVIDER=none
OCR_API_KEY=
ASR_PROVIDER=none
ASR_API_KEY=
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Phase 12 hosted chat: none disables external calls; auto tries configured providers.
AI_PROVIDER_ORDER=groq,nvidia
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
# Model-specific: GLM supports low/high/max and cannot disable thinking.
# Compatible Nemotron models can use none; do not transfer settings blindly.
NVIDIA_REASONING_EFFORT=low
# Use with providers/models that support JSON object mode.
AI_RESPONSE_FORMAT=json_object
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_OUTPUT_TOKENS=4096
AI_FALLBACK_ENABLED=true
AI_DEFAULT_LANGUAGE=en
AI_SUPPORTED_LANGUAGES=en,hi,hi-Latn
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_MAX_TOOL_CALLS=3
AI_MAX_CONTEXT_CHARS=24000
# Conservative UTF-8 byte plus framing upper bound; includes prompt/history/evidence.
AI_MAX_INPUT_TOKENS=3000
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_RESPONSE_BYTES=131072
AI_COOLDOWN_SECONDS=60
# 0 = no application budget; positive value = provider requests per worker per UTC day.
AI_DAILY_REQUEST_BUDGET=0
ASSISTANT_QUESTION_CHARS=1200
# Existing name retained; caps signed user/assistant messages, not only questions.
ASSISTANT_HISTORY_QUESTIONS=8
ASSISTANT_RECORD_LIMIT=12
ASSISTANT_EXCERPT_CHARS=300
ASSISTANT_CONVERSATION_TTL_SECONDS=1800
ASSISTANT_MAX_REQUESTS=4
ASSISTANT_WINDOW_SECONDS=60
ASSISTANT_MAX_REQUESTS_PER_SESSION=20
ASSISTANT_MAX_CONCURRENT=2
# Hosting platforms may set PORT instead of API_PORT.
