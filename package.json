{
  "name": "pravaha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "server": "python scripts/run_backend.py --reload",
    "start": "python scripts/run_backend.py",
    "build": "npm --workspace frontend run build",
    "lint": "eslint .",
    "preview": "npm --workspace frontend run preview",
    "test": "node --experimental-sqlite --test tests/*.test.js tests/legacy/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0"
  }
}
